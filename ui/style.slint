import { Palette } from "std-widgets.slint";

// 状態を表す色の役割。**色そのものではなく意味**を渡す（`docs/rules/slint.md` の
// 「状態→UI 文言の対応表は Rust の網羅 match に置き、Slint の三項連鎖にしない」と同じ趣旨で、
// 状態→色の対応表もここ 1 箇所に持つ）。Rust 側は文言と一緒にこの値を渡す。
export enum StatusTone {
    // 事実を述べるだけ（未取得・件数など）。
    neutral,
    // 進行中（ダウンロード中など）。
    active,
    // 完了・準備できている。
    done,
    // 壊れてはいないが、そのままでは意図どおり動かない（config での上書き、非対応アプリ）。
    caution,
    // 失敗した。
    danger,
}

// shoki のデザイントークン。アプリアイコンの「和紙の地・墨・朱の落款」を起点にした配色と、
// タイポグラフィ・淡色の値を 1 箇所へ集約する（#127）。全ウィンドウで共有する。
//
// **OS の `Palette` に色を委ねない**: shoki 固有の紙色を出すため、面・文字・枠は下の値を使う。
// ライト/ダークの切り替えだけ `Palette.color-scheme` に従う（OS の設定に追従するため）。
// 個々の `.slint` で色を直書きしないこと——片方のテーマだけ調整が漏れる。
export global Style {
    // いまダークテーマか。色の分岐はすべてこの 1 つを見る。
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // --- 面（紙） ---
    // ウィンドウの地。
    out property <brush> paper: root.dark ? #1b1a17 : #f3ede2;
    // 地より一段持ち上がる帯（一覧のヘッダ・フッタ）。
    out property <brush> paper-raised: root.dark ? #212019 : #f7f2e9;
    // 設定のまとまりを載せる面。
    out property <brush> sheet: root.dark ? #232220 : #faf7f0;
    // 面の中でさらに沈める部分（従属ブロック・一覧の区切り見出し）。
    out property <brush> sheet-sunken: root.dark ? #1f1e1b : #f6f1e7;
    // 入力コントロールの面。
    out property <brush> field: root.dark ? #2b2926 : #f3ede2;

    // --- 枠 ---
    // コントロール・ウィンドウの縁（いちばん強い）。
    out property <brush> rule-strong: root.dark ? #45423a : #cfc5b2;
    // 面の縁。
    out property <brush> rule: root.dark ? #34322d : #e2d9c8;
    // 面の内側の区切り（いちばん弱い）。
    out property <brush> hairline: root.dark ? #2c2a26 : #eae2d4;

    // --- 文字（墨） ---
    out property <brush> ink: root.dark ? #ece6d9 : #221f1a;
    // 補助テキスト（説明・状態）。
    out property <brush> ink-muted: root.dark ? #9a9284 : #6b6357;
    // さらに弱いテキスト（注記・バージョン）。
    out property <brush> ink-faint: root.dark ? #8a8271 : #8b8274;

    // --- 朱（落款） ---
    // 唯一のアクセント。多用しない: 見出しの標・選択中の標・主となるボタンだけに使う。
    out property <brush> seal: root.dark ? #e2704f : #c04a2c;
    out property <brush> seal-pressed: root.dark ? #c9563a : #a83e22;
    // 朱の面の上に載る文字。
    out property <brush> on-seal: root.dark ? #1b1a17 : #fdfbf6;

    // --- 状態色 ---
    // 「壊れてはいないが、そのままでは動かない」注意色。danger と分ける（直せるエラーに見せない）。
    out property <brush> caution: root.dark ? #d99b6a : #96601a;
    // 失敗。
    out property <brush> danger: root.dark ? #e08172 : #a53326;
    // 完了・準備できている。
    out property <brush> done: root.dark ? #6b9159 : #4a6b3f;
    // 状態のドットは文字より一段濃くする（6px の点は文字色のままだと沈む）。
    out property <brush> caution-mark: #c98a2b;
    out property <brush> done-mark: #6b9159;

    // 状態の意味 → 文字色 / ドット色。**網羅の対応表はここだけ**に置く。
    pure public function tone-ink(tone: StatusTone) -> brush {
        return tone == StatusTone.done
            ? root.done
            : tone == StatusTone.caution || tone == StatusTone.active
                ? root.caution
                : tone == StatusTone.danger ? root.danger : root.ink-muted;
    }
    pure public function tone-mark(tone: StatusTone) -> brush {
        return tone == StatusTone.done
            ? root.done-mark
            : tone == StatusTone.caution || tone == StatusTone.active
                ? root.caution-mark
                : tone == StatusTone.danger ? root.danger : root.ink-faint;
    }

    // --- タイポグラフィ ---
    out property <length> detail-title-size: 16px; // 詳細見出し（Recordings の日時）
    // セクション見出し（大文字・字間広め）。本文より小さく、色と字間で見出しだと分かるようにする。
    out property <length> section-size: 11px;
    out property <length> section-tracking: 1.4px;
    // 面の中の小見出し・タブのラベル。
    out property <length> heading-size: 12px;
    out property <length> body-size: 13px; // 本文・設定名
    out property <length> label-size: 12.5px; // 行のラベル（値と対になるもの）
    out property <length> caption-size: 11.5px; // 補助テキスト（説明・状態・パス）
    out property <length> badge-size: 9.5px; // バッジ（音源・In use 等）
    out property <length> badge-tracking: 0.9px;
    out property <int> semibold: 600;
    out property <int> regular: 400; // 通常ウェイト（semibold と対で明示するときに使う）
    out property <float> muted-alpha: 0.4; // 補助テキストの淡色化（transparentize の引数）
    out property <float> disabled-opacity: 0.45; // 従属/未選択ブロックの淡色化（opacity）

    // --- 寸法 ---
    out property <length> card-radius: 9px;
    out property <length> control-radius: 6px;
    out property <length> badge-radius: 4px;
    // セクション見出しの標と、選択中の行の標。同じ朱の縦棒で、太さだけ変える。
    out property <length> mark-width: 4px;
    out property <length> row-mark-width: 3px;

    // アクセント背景の上に載る前景（既存コードの互換のため残す。中身は `on-seal` と同じ）。
    out property <brush> on-accent-foreground: root.on-seal;
    // 再生中セグメントのハイライト背景（朱の淡色）。
    out property <brush> segment-highlight: root.seal.transparentize(0.88);
    // 一覧の区切り見出しの背景。
    out property <brush> row-heading-background: root.sheet-sunken;
}
