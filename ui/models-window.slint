import { ModelList, ModelRow, ModelStatus } from "model-list.slint";

// 一覧の型と部品はここを経由して外へ出す（`ui/app-window.slint` の再エクスポート先を
// 一覧の置き場所と別に保つ）。
export { ModelList, ModelRow, ModelStatus }

// モデル管理ウィンドウ。設定画面のボタンから開く。
// 文字起こし用（whisper）と議事録要約用（LLM）のカタログ全件を種別ごとに並べ、**取得・削除・
// 使用するモデルの選択**をここで行う（#138）。`models/` にあるカタログ外のファイルも末尾に並べて
// 掃除できるようにする（#117）。
//
// 中身は `ModelList` が持つ（#140 で切り出した）。このウィンドウが持つのは、ウィンドウとしての
// 設定（題・サイズ）と、この画面向けの説明文だけ。
export component ModelsWindow inherits Window {
    title: "Models";
    // 幅・高さは src/main.rs の MODELS_WIDTH/HEIGHT と一致させること（片方だけ変えない）。
    // preferred だけだと中身の最小高さに引っ張られて潰れるため min も指定する。
    // 行は「名前・説明・状態」の 3 段＋右にサイズと最大 2 つのボタンなので、#117 の 460px では
    // 横が詰まる。高さはカタログ全件（8 件）＋見出し 2 行が入る値。
    min-width: 560px;
    min-height: 520px;
    preferred-width: 560px;
    preferred-height: 520px;

    // 以下は `ModelList` へそのまま渡す（説明は `ui/model-list.slint`）。Rust 側から見た
    // 名前を変えないため、ウィンドウにも同じ名前で持たせている。
    in property <[ModelRow]> models;
    in property <string> total-text;
    in property <string> empty-text;
    in property <string> notice;
    in-out property <bool> show-delete-confirm: false;
    in-out property <int> delete-index: 0;

    callback use-model(int);
    callback download-model(int);
    callback delete-model(int);

    ModelList {
        models: root.models;
        // 一覧でできること（選択・先行取得・削除）と、削除が完全削除であることを伝える。
        // **再取得できるかは行ごとに違う**ので、そこは確認モーダルの説明
        // （`windows::models::model_delete_detail`）へ任せる。見出しはウィンドウタイトルが
        // 兼ねる（Recordings ウィンドウと同じ流儀）。
        intro: "Choose which model to use, download one ahead of time, or delete the ones you no longer need. Deleting frees the space immediately — nothing goes to the Trash.";
        total-text: root.total-text;
        empty-text: root.empty-text;
        notice: root.notice;
        // モーダルの状態は確認用バイナリ（`examples/models_view.rs`）が外から立てるので、
        // ウィンドウを素通りさせる（`<=>` で両方向に束ねる）。
        show-delete-confirm <=> root.show-delete-confirm;
        delete-index <=> root.delete-index;

        use-model(index) => {
            root.use-model(index);
        }
        download-model(index) => {
            root.download-model(index);
        }
        delete-model(index) => {
            root.delete-model(index);
        }
    }
}
