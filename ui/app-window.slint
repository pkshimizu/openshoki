import { Button, CheckBox, ComboBox, ScrollView, SpinBox, Palette } from "std-widgets.slint";
import { Style } from "style.slint";

// Recordings ウィンドウは別ファイルで定義し、ここから再エクスポートして 1 つのエントリ
// （build.rs は app-window.slint のみコンパイル）に含める。Rust 側は include_modules! で
// RecordingsWindow / SessionRow を得る。
export { RecordingsWindow, SessionRow } from "recordings-window.slint";
// モデル一覧ウィンドウ（#117）。同じく再エクスポートするだけで `build.rs` の変更は要らない。
export { ModelsWindow, ModelRow } from "models-window.slint";

// 自動録音のトリガーとして登録したアプリ 1 件。`limitation-note` が空でなければ、そのアプリを
// 検知できない旨をリストに添えて出す（文言と判定は Rust 側の `auto_record_limitation`）。
export struct TriggerApp {
    name: string,
    limitation-note: string,
}

// 「Trigger apps」一覧の 1 行。名前と、検知できないアプリの注記、削除ボタンを持つ。
// 行の中身が入れ子のレイアウトになるため、for の中へ直書きせず部品にする。
component TriggerAppRow inherits VerticalLayout {
    in property <TriggerApp> app;
    // 2 行目以降の先頭に行区切りの罫線を置くか（先頭行では出さない）。
    in property <bool> separated;
    in property <bool> removable;
    callback remove();

    Rectangle {
        height: root.separated ? 1px : 0px;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        // 名前と注記を縦に積む。注記が無いときは行が空くだけにならないよう Text 自体を出さない。
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.app.name;
                font-size: Style.body-size;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.app.limitation-note != "": Text {
                text: root.app.limitation-note;
                font-size: Style.caption-size;
                color: Style.caution;
                wrap: word-wrap;
            }
        }

        Button {
            text: "Remove";
            enabled: root.removable;
            clicked => {
                root.remove();
            }
        }
    }
}

// 設定項目のまとまりを表すセクション枠。GroupBox の既定描画ではなく「角丸・1px 枠線・塗りなし」の
// 箱＋内側見出しで組み、配色は Palette でライト/ダークに追従させる（色をハードコードしない）。
component SettingsSection inherits Rectangle {
    in property <string> title;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 8px;
    background: transparent;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text {
            text: root.title;
            font-size: Style.heading-size;
            font-weight: Style.semibold;
            color: Palette.foreground;
        }

        @children
    }
}

// 常駐アプリの設定画面。トレイメニューから表示する。
// 「録音ファイルの保存先」「登録アプリのマイク使用で自動録音」「自動停止の待ち時間」
// 「録音停止時の自動文字起こし」を、意味のまとまりでセクション化して設定できる。
export component AppWindow inherits Window {
    title: "shoki";
    // preferred だけだと中身の最小高さ（≒0）に引っ張られて潰れるため、min も指定する。
    // 幅・高さは src/main.rs の WINDOW_WIDTH/HEIGHT と一致させること（片方だけ変えない）。
    // 幅は 420 固定。高さは 3 セクション＋Transcription の Language/Model 行・状態行・
    // 議事録要約のトグルとモデル行・説明行・状態行・モデル管理ボタン、＋末尾のバージョン行に
    // 合わせた値
    // （中身を足すときは `examples/settings_view.rs -- snapshot` で見て、ここと
    // `WINDOW_HEIGHT` を揃えて直す）。
    min-width: 420px;
    min-height: 900px;
    preferred-width: 420px;
    preferred-height: 900px;

    // 現在の録音ファイル保存先（表示用）。Rust 側から設定する。
    in property <string> recording-dir;
    // 「登録アプリのマイク使用で自動録音」の ON/OFF。起動時に Rust 側が設定値で初期化し、以後は
    // トグル操作で Slint が状態を保持する（in-out）。
    in-out property <bool> auto-record-app;
    // 登録アプリの一覧（Rust 側の app_mic_triggers を反映）。
    in property <[TriggerApp]> app-list;
    // 自動停止のデバウンス秒数。起動時に Rust 側が設定値で初期化し、以後は SpinBox で編集する（in-out）。
    // 範囲は minimum/maximum（下の SpinBox）で制限し、Rust 側の DEBOUNCE_MIN/MAX_SECS と一致させる。
    in-out property <int> auto-stop-debounce-secs;
    // 「録音停止時に自動文字起こし」の ON/OFF。起動時に Rust 側が設定値で初期化し、以後は
    // トグル操作で Slint が状態を保持する（in-out。保存失敗時は Rust 側が書き戻す）。
    in-out property <bool> auto-transcribe;
    // 文字起こしの言語の表示名一覧（Rust 側の TRANSCRIBE_LANGUAGES を反映。並び順も Rust が決める）。
    in property <[string]> transcribe-languages;
    // 選択中の言語のカタログ内インデックス。起動時に Rust 側が設定値で初期化し、以後は
    // ComboBox で編集する（in-out。保存失敗時は Rust 側が書き戻す）。
    in-out property <int> transcribe-language-index;
    // 内蔵 whisper モデルの表示名一覧（Rust 側の whisper_model::CATALOG を反映。名前・サイズ・
    // 説明を 1 行に整形済み）。
    in property <[string]> whisper-models;
    // 選択中モデルのカタログ内インデックス。起動時に Rust 側が設定値で初期化し、以後は
    // ComboBox で編集する（in-out。保存失敗時は Rust 側が書き戻す）。
    in-out property <int> whisper-model-index;
    // 選択中モデルの取得状況テキスト（Rust 側が定期的に更新する）。
    in property <string> whisper-model-status;
    // 「文字起こしのあと議事録要約を自動生成」の ON/OFF。起動時に Rust 側が設定値で初期化し、
    // 以後はトグル操作で Slint が状態を保持する（in-out。保存失敗時は Rust 側が書き戻す）。
    in-out property <bool> auto-summarize;
    // 要約に使う LLM の表示名一覧（Rust 側の summary_model::CATALOG を反映。whisper と同じく
    // 名前・サイズ・説明を 1 行に整形済み）。選択肢の下に出す説明行もここから導出する。
    in property <[string]> summary-models;
    // 選択中モデルのカタログ内インデックス。起動時に Rust 側が設定値で初期化し、以後は
    // ComboBox で編集する（in-out。保存失敗時は Rust 側が書き戻す）。
    in-out property <int> summary-model-index;
    // 選択中モデルの取得状況（Rust 側が定期的に更新する）。モデル名は ComboBox が出すので
    // 含めない（`summary_model_status_text`）。
    in property <string> summary-model-status;
    // config.toml でモデルファイルのパスを上書きしているか（`summary_model_path`）。上書き中は
    // カタログの選択が使われないので、選択肢の説明行を出さない（状態行がその旨を示す）。
    in property <bool> summary-model-overridden;
    // 設定画面の末尾に出すバージョン表記（例: `shoki v0.1.0`）。組み立てと理由は Rust 側の
    // `app_version_text` を参照。
    in property <string> app-version;
    // 「フォルダを選択」押下。Rust 側でネイティブのフォルダ選択ダイアログを開く。
    callback choose-folder();
    // アプリのマイク使用 自動録音トグルの切り替え。新しい ON/OFF を渡し、Rust 側で設定へ永続化する。
    callback toggle-auto-record-app(bool);
    // 自動停止デバウンス秒数の変更。新しい秒数を渡し、Rust 側で範囲を丸めて永続化する。
    callback change-auto-stop-debounce(int);
    // 「アプリを追加」押下。Rust 側で .app 選択ダイアログを開き、登録する。
    callback add-app();
    // 登録アプリの削除。一覧のインデックスを渡す。
    callback remove-app(int);
    // 自動文字起こしトグルの切り替え。新しい ON/OFF を渡し、Rust 側で設定へ永続化する。
    callback toggle-auto-transcribe(bool);
    // 文字起こし言語の変更。カタログ内インデックスを渡し、Rust 側でコードへ変換して永続化する。
    callback change-transcribe-language(int);
    // 内蔵 whisper モデルの変更。カタログ内インデックスを渡し、Rust 側で ID へ変換して永続化し、
    // 未取得ならダウンロードを開始する。
    callback change-whisper-model(int);
    // 議事録要約トグルの切り替え。新しい ON/OFF を渡し、Rust 側で設定へ永続化する。
    callback toggle-auto-summarize(bool);
    // 要約 LLM の変更。カタログ内インデックスを渡し、Rust 側で ID へ変換して永続化する。
    // 未取得のモデルの取得を始めるかは設定次第（`summary_model_downloads_on_select`）。
    callback change-summary-model(int);
    // 「Manage Downloaded Models…」押下。取得済みモデルの一覧ウィンドウを開く（#117）。
    callback open-models-window();

    VerticalLayout {
        alignment: start;
        spacing: 14px;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 18px;
        padding-bottom: 22px;

        // --- Recording: 保存先フォルダ ---
        SettingsSection {
            title: "Recording";
            Text {
                text: "Folder";
                font-size: Style.body-size;
                color: Palette.foreground;
            }
            // パス（折り返し）とボタン（折り返さない）を同一行・両端揃えにする。
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.recording-dir;
                    wrap: word-wrap;
                    font-size: Style.caption-size;
                    color: Palette.foreground.transparentize(Style.muted-alpha);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Choose Folder";
                    horizontal-stretch: 0;
                    clicked => {
                        root.choose-folder();
                    }
                }
            }
        }

        // --- Auto-record: 登録アプリのマイク使用に連動 ---
        SettingsSection {
            title: "Auto-Record";
            // 複数行ラベルにするため、CheckBox（テキストなし）＋折り返し Text を横並びにする。
            // トグルはチェックボックス本体で行う。
            HorizontalLayout {
                spacing: 8px;
                CheckBox {
                    // 双方向束縛にする。片方向（`checked: root.…`）だと、ユーザーが一度操作した
                    // 時点でウィジェット側の代入がバインディングを外し、保存失敗時に Rust が
                    // 書き戻しても表示が戻らない（`docs/rules/slint.md`）。
                    checked <=> root.auto-record-app;
                    toggled => {
                        root.toggle-auto-record-app(self.checked);
                    }
                }

                Text {
                    text: "Auto-record while a registered app uses the mic — for calls (macOS 14.4+)";
                    wrap: word-wrap;
                    font-size: Style.body-size;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // 従属コントロール（delay・Trigger apps）を左インデントし、自動録音 OFF のときは
            // 淡色化（opacity）＋各操作の無効化（enabled）で従属関係を示す。無効化条件は
            // enabled-gate に一本化し、opacity と各 enabled が食い違わないようにする。
            deps := Rectangle {
                property <bool> enabled-gate: root.auto-record-app;
                opacity: enabled-gate ? 1.0 : Style.disabled-opacity;
                VerticalLayout {
                    padding-left: 23px;
                    padding-top: 6px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Auto-stop delay (seconds)";
                            font-size: Style.body-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }

                        SpinBox {
                            // 範囲は src/config.rs の DEBOUNCE_MIN_SECS / DEBOUNCE_MAX_SECS と一致させること。
                            minimum: 1;
                            maximum: 60;
                            // 双方向束縛。Rust 側が丸めた値・保存済みの値を書き戻せるようにする
                            // （理由は上のチェックボックスのコメント参照）。
                            value <=> root.auto-stop-debounce-secs;
                            // 途絶が有効なのは自動録音 ON のときだけなので、OFF では無効化する。
                            enabled: deps.enabled-gate;
                            edited(secs) => {
                                root.change-auto-stop-debounce(secs);
                            }
                        }
                    }

                    Text {
                        text: "Trigger apps";
                        font-size: Style.body-size;
                        color: Palette.foreground;
                    }

                    // フィールド風のリストボックス（入力欄と同じ背景＋角丸＋枠）。空でも枠を保つ。
                    Rectangle {
                        height: 96px;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 6px;
                        background: Palette.control-background;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                for app[i] in root.app-list: TriggerAppRow {
                                    app: app;
                                    separated: i > 0;
                                    removable: deps.enabled-gate;
                                    remove => {
                                        root.remove-app(i);
                                    }
                                }
                            }
                        }
                    }

                    // 注記は既知のアプリ（Safari 等）にしか出せないため、一覧全体への注意書きも置く
                    // （WKWebView を使う任意のアプリが同じ制約を受けるが、登録時に見分けられない）。
                    Text {
                        text: "Safari and other WebKit-based apps can't be detected — record those manually";
                        font-size: Style.caption-size;
                        color: Palette.foreground.transparentize(Style.muted-alpha);
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Add app…";
                            enabled: deps.enabled-gate;
                            clicked => {
                                root.add-app();
                            }
                        }
                    }
                }
            }
        }

        // --- Transcription: 録音停止時の自動文字起こし ---
        SettingsSection {
            title: "Transcription";
            HorizontalLayout {
                spacing: 8px;
                CheckBox {
                    checked <=> root.auto-transcribe;
                    toggled => {
                        root.toggle-auto-transcribe(self.checked);
                    }
                }

                Text {
                    text: "Transcribe recordings on stop — on-device Whisper";
                    wrap: word-wrap;
                    font-size: Style.body-size;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // 文字起こしに従属するコントロール群を左インデントし、文字起こし OFF のときは
            // 淡色化＋無効化で従属関係を示す（Auto-record セクションの deps と同じ流儀）。
            transcribe-deps := Rectangle {
                property <bool> enabled-gate: root.auto-transcribe;
                opacity: enabled-gate ? 1.0 : Style.disabled-opacity;
                VerticalLayout {
                    padding-left: 23px;
                    padding-top: 6px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Language";
                            font-size: Style.body-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }

                        ComboBox {
                            model: root.transcribe-languages;
                            current-index <=> root.transcribe-language-index;
                            enabled: transcribe-deps.enabled-gate;
                            selected => {
                                root.change-transcribe-language(self.current-index);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Model";
                            font-size: Style.body-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }

                        ComboBox {
                            model: root.whisper-models;
                            current-index <=> root.whisper-model-index;
                            enabled: transcribe-deps.enabled-gate;
                            selected => {
                                root.change-whisper-model(self.current-index);
                            }
                        }
                    }

                    Text {
                        // 選択中モデルの取得状況（Rust 側が組み立てる。例: Downloaded /
                        // Downloading… 42% / Not downloaded — downloads automatically (465 MB)）。
                        text: root.whisper-model-status;
                        font-size: Style.caption-size;
                        color: Palette.foreground.transparentize(Style.muted-alpha);
                    }

                    // 議事録要約は文字起こしの結果を入力にするので、文字起こしの従属として置く
                    // （文字起こし OFF では要約も走らない、という実装と表示を一致させる）。
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            checked <=> root.auto-summarize;
                            enabled: transcribe-deps.enabled-gate;
                            toggled => {
                                root.toggle-auto-summarize(self.checked);
                            }
                        }

                        Text {
                            text: "Write meeting minutes — on-device LLM";
                            wrap: word-wrap;
                            font-size: Style.body-size;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            // whisper の「Model」と同じセクションに並ぶので、どちらのモデルか
                            // 分かるラベルにする（whisper 側は直上のチェックボックス文言
                            // 「on-device Whisper」で分かるため素の「Model」のまま）。
                            text: "Minutes Model";
                            font-size: Style.body-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }

                        ComboBox {
                            model: root.summary-models;
                            current-index <=> root.summary-model-index;
                            enabled: transcribe-deps.enabled-gate;
                            selected => {
                                root.change-summary-model(self.current-index);
                            }
                        }
                    }

                    if !root.summary-model-overridden: Text {
                        // 選択中の選択肢の全文（例: Qwen2.5 7B Instruct — 4.4 GB — 54 s and
                        // 8.2 GB of memory for a 4-min meeting, more faithful）。ComboBox の行は
                        // 箱幅で省略される（開いてもポップアップは箱幅のまま）ため、選ぶ材料になる
                        // 目安をここで折り返して読めるようにする。選択位置から導出するので、
                        // 「選択は 3B・説明は 7B」のような食い違いが起こらない。
                        text: root.summary-models[root.summary-model-index];
                        wrap: word-wrap;
                        font-size: Style.caption-size;
                        color: Palette.foreground.transparentize(Style.muted-alpha);
                    }

                    Text {
                        // 選択中モデルの取得状況（Rust 側が組み立てる。例: Not downloaded —
                        // downloads when minutes are generated (4.4 GB)）。取得の契機が設定で
                        // 変わるぶん whisper の状態行より長い文言があるので折り返す。
                        text: root.summary-model-status;
                        wrap: word-wrap;
                        font-size: Style.caption-size;
                        color: Palette.foreground.transparentize(Style.muted-alpha);
                    }
                }
            }

            Text {
                // モデルは内蔵（初回に自動ダウンロード）。これまで通信ゼロだったアプリで唯一の
                // 外部通信になるため、接続先と「音声は送らない」ことを明示する（透明性）。
                text: "Models download from Hugging Face — audio is never uploaded";
                wrap: word-wrap;
                font-size: Style.caption-size;
                color: Palette.foreground.transparentize(Style.muted-alpha);
            }

            // 取得済みモデルの管理（#117）。文字起こしと議事録要約の両方のモデルが対象なので、
            // どちらかのセクションの中ではなく、両方を含む Transcription セクションの外に置く。
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Manage Downloaded Models…";
                    clicked => {
                        root.open-models-window();
                    }
                }
            }
        }

        // どのビルドを動かしているかを確認できるように、末尾へ控えめに出す。
        Text {
            text: root.app-version;
            font-size: Style.caption-size;
            color: Palette.foreground.transparentize(Style.muted-alpha);
            horizontal-alignment: center;
        }
    }
}
