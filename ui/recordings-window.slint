import { Button, ListView, ScrollView, Palette } from "std-widgets.slint";
import { Style } from "style.slint";

// 文字起こしの表示状態。Rust 側（main.rs の transcript_display_status）がワーカーの
// 進行状況と JSON の有無から合成して詰める。
export enum TranscriptStatus {
    not-transcribed,
    transcribing,
    done,
    failed,
}

// 議事録要約の表示状態。Rust 側（main.rs の summary_display_status）がワーカーの進行状況と
// `summary.md` の有無から合成して詰める。TranscriptStatus と同じ流儀（先頭が未生成＝既定値）。
export enum SummaryStatus {
    not-summarized,
    summarizing,
    done,
    failed,
}

// 一覧の 1 行分。Rust の recordings::RecordingSession から詰める。
export struct SessionRow {
    datetime: string,
    has-mic: bool,
    has-system: bool,
    transcript-status: TranscriptStatus,
}

// 議事録要約の表示 1 行分。行分けと見出し判定（`#` を落として `is-heading` を立てる）は Rust の
// `summary_rows` が行う（**その doc が正**。Markdown をどこまで解釈するかもそちら）。
export struct SummaryRow {
    text: string,
    is-heading: bool,
}

// トランスクリプトの表示 1 行分。Rust の transcript::TranscriptSegment から詰める
// （speaker は "Mic" / "System"、time は "mm:ss"、1 時間以上は "h:mm:ss"）。配色判定はラベル文字列の
// 比較でなく is-mic で行う（ラベルを変えても配色が壊れないように）。クリック時のシーク秒は
// Rust 側が index で解決する。
export struct TranscriptRow {
    speaker: string,
    is-mic: bool,
    time: string,
    text: string,
}

// 音源バッジ（`Mic` / `System`）。選択行では白アウトライン、非選択では補助色アウトライン。
component SourceBadge inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    border-radius: 4px;
    border-width: 1px;
    border-color: selected ? Style.on-accent-foreground : Palette.border;
    background: transparent;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.label;
            font-size: Style.badge-size;
            font-weight: Style.semibold;
            color: root.selected ? Style.on-accent-foreground : Palette.foreground.transparentize(Style.muted-alpha);
        }
    }
}

// トランスクリプトの話者バッジ。Mic はアクセント色背景＋白文字、System はニュートラル背景。
component SpeakerBadge inherits Rectangle {
    in property <string> label;
    in property <bool> accent;
    border-radius: 4px;
    background: accent ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.label;
            font-size: Style.badge-size;
            font-weight: Style.semibold;
            color: root.accent ? Style.on-accent-foreground : Palette.foreground;
        }
    }
}

// 破壊的操作用のボタン。std-widgets の Button は文字色・背景色を変えられないため、同等の
// 見た目を Rectangle + TouchArea で作る。filled=false はヘッダの Delete（赤文字・通常背景）、
// filled=true は確認モーダルの確定ボタン（赤背景・白文字）。
component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> filled: false;

    callback clicked();

    border-radius: 6px;
    border-width: root.filled ? 0 : 1px;
    border-color: Palette.border;
    background: root.filled
        ? (touch.pressed && root.enabled ? Style.danger.darker(15%) : Style.danger)
        : (touch.pressed && root.enabled
            ? Palette.control-background.darker(8%)
            : Palette.control-background);
    opacity: root.enabled ? 1.0 : Style.disabled-opacity;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 5px;
        padding-bottom: 5px;
        Text {
            text: root.text;
            font-size: Style.body-size;
            font-weight: root.filled ? Style.semibold : Style.regular;
            color: root.filled ? Style.on-accent-foreground : Style.danger;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// 右ペイン下段の表示切替タブ（Transcript / Summary）。選択中は前景色＋下線、非選択は muted。
// std-widgets の TabWidget は枠と余白の見た目がこの画面（角丸 1px 枠のセクション）と合わないため、
// 見出し行に並べられる軽いタブを自作する（`SourceBadge` / `DangerButton` と同じ流儀）。
component ViewTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked();

    background: transparent;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.text;
            font-size: Style.heading-size;
            font-weight: root.selected ? Style.semibold : Style.regular;
            color: root.selected
                ? Palette.foreground
                : Palette.foreground.transparentize(Style.muted-alpha);
        }

        // 選択中だけ下線を出す（高さは常に確保して、切替でタブの高さが動かないようにする）。
        Rectangle {
            height: 2px;
            background: root.selected ? Palette.accent-background : transparent;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 再生位置のシークバー。トラック＋アクセント色の塗り（従来の進捗バーのデザイン据え置き）に
// 現在位置のつまみを重ね、当たり判定はバーの上下へ広げて細いバーでも掴みやすくする。
//
// ドラッグ中の分担（**この仕様の正はここ**。他の箇所はここを参照する）: 押下から離すまでを
// `scrubbing` とし、その間は塗り・つまみ（この部品内）と時刻表示（`scrub-preview` → Rust）だけが
// ポインタへ追従するプレビューにして、音は動かさない。離した時点で `seek-to-ratio` を呼び、
// Rust 側が比率を秒へ換算してシークする。MP3 のシークを連続発行して音を途切れさせないためで、
// Rust の再生 tick は `scrubbing` 中 `progress` / 時刻表示の上書きを止める（つまみが震える競合の
// 予防）。コールバック名は使う側・Rust 側（`on_scrub_preview` / `on_seek_to_ratio`）と揃えている。
component SeekBar inherits Rectangle {
    // 使う側から渡される再生位置の比率（0.0〜1.0）。`scrubbing` 中はプレビュー比率が優先される。
    in property <float> progress;
    // 操作できるか。false ならクリック・ドラッグを受けず、つまみも出さない（表示専用に縮退）。
    in property <bool> seekable;
    // ドラッグ中か（上記の分担参照）。使う側の `out property` と `<=>` で束ねるため `in-out` に
    // する（`out` は双方向束縛の対象にできない）。値の更新はこの部品内だけで行い、束ねた時点で
    // 使う側と 1 つのプロパティになるため、ここに初期値は置かない。
    in-out property <bool> scrubbing;
    // ドラッグ中のプレビュー比率（0.0〜1.0）。`scrubbing` の間だけ塗り・つまみの位置に使う。
    property <float> scrub-ratio;
    // 塗り・つまみの位置に使う比率。ドラッグ中はプレビュー、それ以外は再生位置
    // （使う側から来る値は範囲外に備えて丸める）。
    property <float> ratio: root.scrubbing
        ? root.scrub-ratio
        : min(max(root.progress, 0.0), 1.0);
    property <length> knob-size: 13px;

    // ドラッグ中の時刻表示の更新依頼（比率）。シークはしない。
    callback scrub-preview(float);
    // クリック確定・ドラッグ終了（比率）。ここでシークする。
    callback seek-to-ratio(float);

    // 当たり判定の高さ。トラック・つまみはこの中央に置く。
    height: 20px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 5px;
        border-radius: 3px;
        background: Palette.border;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            height: parent.height;
            border-radius: 3px;
            background: Palette.accent-background;
        }
    }

    // つまみは操作できるときだけ出す。中心を塗りの右端に合わせ、両端ではバー内へ収まるよう丸める。
    if root.seekable: Rectangle {
        width: root.knob-size;
        height: self.width;
        border-radius: self.width / 2;
        x: min(max(root.width * root.ratio - self.width / 2, 0px), root.width - self.width);
        y: (root.height - self.height) / 2;
        background: Palette.accent-background;
    }

    TouchArea {
        enabled: root.seekable;
        // ポインタ位置をバー上の比率へ換算した値（バー外へドラッグしても 0.0〜1.0 に収める）。
        property <float> pointer-ratio: min(max(self.mouse-x / self.width, 0.0), 1.0);
        // 追従は scrubbing のときだけ（左ボタン以外のドラッグで表示だけがずれるのを防ぐ）。
        moved => {
            if (root.scrubbing) {
                root.scrub-ratio = self.pointer-ratio;
                root.scrub-preview(root.scrub-ratio);
            }
        }
        // pointer-event はどのボタンでも来るため、開始・確定は左ボタンに限る
        // （右クリックでシークさせない）。取り消しはボタンを問わない。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.scrub-ratio = self.pointer-ratio;
                root.scrubbing = true;
                root.scrub-preview(root.scrub-ratio);
            } else if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.left
                && root.scrubbing) {
                root.seek-to-ratio(root.scrub-ratio);
                root.scrubbing = false;
            } else if (event.kind == PointerEventKind.cancel) {
                // 取り消し（ウィンドウ外へドラッグ等）はシークせず、プレビューを畳んで
                // 再生位置の表示へ戻す。
                root.scrubbing = false;
            }
        }
    }
}

// トレイの「Recordings…」から開く録音一覧ウィンドウ。左＝セッション一覧、右＝再生と文字起こし。
// 配色は Palette でライト/ダークに追従し、サイズ・淡色は共有の Style トークンを使う
// （選択行の白文字はアクセント固定背景のため Style.on-accent-foreground）。
export component RecordingsWindow inherits Window {
    title: "Recordings";
    // 幅・高さは src/main.rs の RECORDINGS_WIDTH/HEIGHT と一致させること（片方だけ変えない）。
    min-width: 720px;
    min-height: 540px;
    preferred-width: 720px;
    preferred-height: 540px;

    // セッション一覧（新しい順）。Rust 側が list_sessions の結果で更新する。
    in property <[SessionRow]> sessions;
    // 選択中セッションの一覧インデックス。未選択は -1。行クリックで更新し select-session を呼ぶ。
    in-out property <int> selected-index: -1;
    // 選択セッションの詳細（Rust 側が選択時に更新する）。
    in property <bool> has-selection;
    in property <string> detail-datetime;
    in property <string> detail-sources;
    // 選択中セッションの文字起こし状態テキスト（Rust 側が組み立てる。例: Transcribed /
    // Transcribing… / Transcription failed / Not transcribed）。
    in property <string> detail-transcript-text;
    // 選択中セッションの文字起こし状態。状態テキストの失敗色の分岐と、実行中判定の導出に
    // 使う（Rust 側が detail-transcript-text と同時に更新する）。
    in property <TranscriptStatus> detail-transcript-status;
    // Transcript セクションの縮退表示（セグメントが無いとき）のラベル。状態→文言の対応表は
    // Rust 側（transcript_placeholder_text）に集約し、ここでは表示するだけ。
    in property <string> detail-transcript-placeholder;
    // 選択中セッションが文字起こし中か。状態 enum から導出し、Rust から個別に set しない
    // （bool と enum の食い違いを作らない）。
    property <bool> detail-transcribing: root.detail-transcript-status == TranscriptStatus.transcribing;
    // 選択中セッションの議事録要約の状態テキスト（Rust 側が組み立てる。例: Summarized /
    // Summarizing… / Summarization failed / Not summarized）。
    in property <string> detail-summary-status-text;
    // 議事録要約の状態。状態テキストの失敗色の分岐と、生成中判定の導出に使う
    // （Rust 側が detail-summary-status-text と同時に更新する）。
    in property <SummaryStatus> detail-summary-status;
    // Summary タブの縮退表示（行が無いとき）のラベル。状態→文言の対応表は Rust 側
    // （summary_placeholder_text）に集約し、ここでは表示するだけ。
    in property <string> detail-summary-placeholder;
    // 選択中セッションの議事録要約（`summary.md` を行単位に分けたもの）。空なら状態依存の
    // ラベルに縮退表示する。
    in property <[SummaryRow]> summary-rows;
    // 選択中セッションが要約生成中か（上の enum から導出。Rust から個別に set しない）。
    property <bool> detail-summarizing: root.detail-summary-status == SummaryStatus.summarizing;
    // 文字起こし・要約のいずれかが走っているか。**従属コントロールの無効化はこの 1 つに
    // 一本化する**（Transcribe / Summarize / Delete。条件を各所へ複写しない。
    // `docs/rules/slint.md`）。走っている間はワーカーがセッションのファイルを読み書きするため、
    // 多重投入も削除もさせない。
    property <bool> detail-busy: root.detail-transcribing || root.detail-summarizing;
    // 選択中セッションに文字起こしがあるか（要約の入力になるので、無ければ Summarize は無効）。
    in property <bool> has-transcript;
    // 選択セッションのトランスクリプト（mic.json / system.json をマージしたもの。新→旧でなく時刻順）。
    // 空なら Transcript セクションは状態依存のラベルに縮退表示する。
    in property <[TranscriptRow]> segments;
    // 現在の再生位置に対応するセグメントの index（ハイライト対象。-1 は該当なし）。
    in property <int> current-segment: -1;
    // 選択セッションが再生可能か（両音源は mix.mp3 生成済み、単一音源は常に可）。false なら
    // 再生ボタンを無効化する。
    in property <bool> playable;
    // 再生状態。playing は Play/Pause ラベルの切替、time-text は "mm:ss / mm:ss"、
    // progress は 0.0〜1.0 の進捗（シークバーの塗り・つまみの位置）。
    in property <bool> playing;
    in property <string> time-text;
    in property <float> progress;
    // シークバーを操作できるか（再生可能かつ全体長が分かる）。Rust 側が選択時に計算して渡す
    // （Slint 側で複合条件を組まない）。false なら表示専用に縮退する。
    in property <bool> seekable;
    // シークバーをドラッグ中か（分担は `SeekBar` の doc コメント参照）。Rust の再生 tick が
    // 上書き抑止の判定に読む。UI が所有する状態なので out にして Rust から set させない
    // （値は SeekBar 側と双方向で束ねる）。
    out property <bool> scrubbing;
    // 削除の確認モーダルの表示状態。Delete 押下で開き、Cancel / 確定で閉じる（Slint 内で完結）。
    in-out property <bool> show-delete-confirm: false;
    // 右ペイン下段が Summary タブを表示しているか。タブの選択は UI が所有し、セッションを
    // 選び直しても保つ（アプリ側の Rust は Transcript / Summary の中身を常に最新へ更新するので、
    // どちらを見せているかを知る必要が無い＝set しない）。`in-out` なのは、確認用バイナリ
    // （`examples/transcript_view.rs`）が Summary タブの見た目を出すために選ぶため。
    in-out property <bool> showing-summary: false;

    // 行クリックでの選択通知。Rust 側で詳細更新・再生対象のロードを行う。
    callback select-session(int);
    // 再生/一時停止トグルと停止。
    callback play-pause();
    callback stop();
    // トランスクリプトのセグメントクリック。その開始秒へ再生位置をスキップする（index を渡す）。
    callback seek-to-segment(int);
    // シークバーのドラッグ中のプレビュー通知（比率 0.0〜1.0）。時刻表示だけを更新する。
    callback scrub-preview(float);
    // シークバーのクリック確定・ドラッグ終了（比率 0.0〜1.0）。秒へ換算してシークする。
    callback seek-to-ratio(float);
    // 「Transcribe」押下。選択中セッションの文字起こしを（再）実行する。インデックスを渡す。
    callback transcribe-session(int);
    // 「Summarize」押下。選択中セッションの議事録要約を（再）生成する。インデックスを渡す
    // （設定 `auto_summarize` とは独立に、押されたら生成する）。
    callback summarize-session(int);
    // 確認モーダルの Delete 押下。選択中セッションをゴミ箱へ移動する（インデックスを渡す）。
    callback delete-session(int);

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        // --- 左ペイン: セッション一覧 ---
        Rectangle {
            width: 236px;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 8px;
            background: Palette.control-background;
            clip: true;

            if root.sessions.length == 0: VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 6px;
                Text {
                    text: "No Recordings Yet";
                    font-size: Style.body-size;
                    font-weight: Style.semibold;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }

                Text {
                    text: "Recordings you make will appear here.";
                    font-size: Style.caption-size;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    color: Palette.foreground.transparentize(Style.muted-alpha);
                }
            }
            if root.sessions.length > 0: ScrollView {
                VerticalLayout {
                    alignment: start;
                    for row[i] in root.sessions: Rectangle {
                        // 行間の区切り罫線（先頭行は出さない）。
                        VerticalLayout {
                            Rectangle {
                                height: i > 0 ? 1px : 0px;
                                background: Palette.border;
                            }

                            rowbg := Rectangle {
                                // 選択状態は id で参照する（レイアウトを跨ぐ parent 参照は Slint で
                                // 使えないため）。
                                property <bool> selected: i == root.selected-index;
                                background: rowbg.selected ? Palette.accent-background : transparent;
                                TouchArea {
                                    clicked => {
                                        root.selected-index = i;
                                        root.select-session(i);
                                    }
                                }

                                VerticalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.datetime;
                                            font-size: Style.body-size;
                                            font-weight: Style.semibold;
                                            color: rowbg.selected ? Style.on-accent-foreground : Palette.foreground;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        // 文字起こしの状態を表すドット（前=透明で場所だけ確保 /
                                        // 中=淡色 / 完了=アクセント / 失敗=警告色）。
                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: row.transcript-status == TranscriptStatus.done
                                                ? (rowbg.selected ? Style.on-accent-foreground : Palette.accent-background)
                                                : row.transcript-status == TranscriptStatus.transcribing
                                                    ? (rowbg.selected ? Style.on-accent-foreground : Palette.foreground).transparentize(Style.muted-alpha)
                                                    : row.transcript-status == TranscriptStatus.failed ? Style.danger : transparent;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 5px;
                                        if row.has-mic: SourceBadge {
                                            label: "Mic";
                                            selected: rowbg.selected;
                                        }
                                        if row.has-system: SourceBadge {
                                            label: "System";
                                            selected: rowbg.selected;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- 右ペイン: 詳細（再生・文字起こし） ---
        Rectangle {
            horizontal-stretch: 1;
            // 未選択（録音ゼロ含む）のときは淡色化して非活性にする。
            opacity: root.has-selection ? 1.0 : Style.disabled-opacity;

            if !root.has-selection: Text {
                text: "No Recording Selected";
                font-size: Style.body-size;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(Style.muted-alpha);
            }

            // alignment は既定（stretch）にし、余った高さを Transcript セクション
            // （vertical-stretch: 1）へ与える。alignment: start だと全子要素が推奨サイズに
            // 縮み、中身が可変の Transcript の箱が見出しだけに潰れる。
            if root.has-selection: VerticalLayout {
                spacing: 12px;

                // ヘッダ: 日時・音源の内訳と、文字起こし／議事録要約の状態＋
                // Transcribe / Summarize / Delete。
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.detail-datetime;
                            font-size: Style.detail-title-size;
                            font-weight: Style.semibold;
                            color: Palette.foreground;
                        }

                        Text {
                            text: root.detail-sources;
                            font-size: Style.caption-size;
                            color: Palette.foreground.transparentize(Style.muted-alpha);
                        }

                        Text {
                            text: root.detail-transcript-text;
                            font-size: Style.caption-size;
                            // 失敗だけ警告色にして muted に埋もれさせず一目で分かるようにする。
                            color: root.detail-transcript-status == TranscriptStatus.failed
                                ? Style.danger
                                : Palette.foreground.transparentize(Style.muted-alpha);
                        }

                        Text {
                            text: root.detail-summary-status-text;
                            font-size: Style.caption-size;
                            // 失敗の扱いは文字起こしの状態行と揃える。
                            color: root.detail-summary-status == SummaryStatus.failed
                                ? Style.danger
                                : Palette.foreground.transparentize(Style.muted-alpha);
                        }
                    }

                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        spacing: 8px;
                        Button {
                            text: "Transcribe";
                            // 完了済み・失敗・未実施のいずれからも（再）実行できる
                            // （言語・モデル変更後のやり直し用途）。無効化の理由は detail-busy。
                            enabled: !root.detail-busy;
                            clicked => {
                                root.transcribe-session(root.selected-index);
                            }
                        }

                        Button {
                            text: "Summarize";
                            // 要約は文字起こしを入力にするので、無いセッションでは押させない
                            // （生成済み・失敗からは押し直せる。モデル変更後のやり直し用途）。
                            enabled: root.has-transcript && !root.detail-busy;
                            clicked => {
                                root.summarize-session(root.selected-index);
                            }
                        }

                        DangerButton {
                            text: "Delete";
                            enabled: !root.detail-busy;
                            clicked => {
                                root.show-delete-confirm = true;
                            }
                        }
                    }
                }

                // Playback セクション。
                Rectangle {
                    vertical-stretch: 0;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 8px;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 14px;
                        spacing: 11px;
                        Text {
                            text: "Playback";
                            font-size: Style.heading-size;
                            font-weight: Style.semibold;
                            color: Palette.foreground;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.playing ? "Pause" : "Play";
                                enabled: root.playable;
                                clicked => {
                                    root.play-pause();
                                }
                            }

                            Button {
                                text: "Stop";
                                enabled: root.playable;
                                clicked => {
                                    root.stop();
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: root.time-text;
                                font-size: Style.caption-size;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(Style.muted-alpha);
                            }
                        }

                        // 再生位置のシークバー（分担・仕様は SeekBar の doc コメント参照）。
                        SeekBar {
                            progress: root.progress;
                            seekable: root.seekable;
                            scrubbing <=> root.scrubbing;
                            scrub-preview(ratio) => {
                                root.scrub-preview(ratio);
                            }
                            seek-to-ratio(ratio) => {
                                root.seek-to-ratio(ratio);
                            }
                        }
                    }
                }

                // Transcript / Summary セクション。タブで表示を切り替える。Transcript は
                // セグメントを時刻順に表示し、現在再生位置をハイライト、クリックでその開始秒へ
                // シークする。Summary は `summary.md` を行単位に表示する（クリック連動は無い。
                // #81 のスコープ外）。どちらも中身が無いときは状態依存のラベルに縮退。
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 8px;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            vertical-stretch: 0;
                            alignment: start;
                            spacing: 18px;
                            ViewTab {
                                text: "Transcript";
                                selected: !root.showing-summary;
                                clicked => {
                                    root.showing-summary = false;
                                }
                            }

                            ViewTab {
                                text: "Summary";
                                selected: root.showing-summary;
                                clicked => {
                                    root.showing-summary = true;
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            if !root.showing-summary: Rectangle {
                                // 文字起こしがあればセグメント一覧、無ければ縮退表示。長時間録音では
                                // セグメントが数千件になり得るため、可視範囲だけ生成する ListView を使う
                                // （ScrollView + for は全行を即時生成し、選択時のヒッチにつながる）。
                                if root.segments.length > 0: ListView {
                                    for seg[i] in root.segments: Rectangle {
                                        // 現在再生位置のセグメントをハイライト（淡色背景＋左 3px 罫線）。
                                        property <bool> active: i == root.current-segment;
                                        background: active ? Style.segment-highlight : transparent;
                                        // ListView の行は自身の高さを明示する（word-wrap する本文の
                                        // 実高さに追従させる）。
                                        height: row-content.preferred-height;
                                        TouchArea {
                                            clicked => {
                                                root.seek-to-segment(i);
                                            }
                                        }

                                        row-content := HorizontalLayout {
                                            // 左端のアクセント罫線（active のときだけ幅を持つ）。
                                            Rectangle {
                                                width: active ? 3px : 0px;
                                                background: Palette.accent-background;
                                            }

                                            VerticalLayout {
                                                padding-left: 8px;
                                                padding-right: 6px;
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                spacing: 3px;
                                                HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 7px;
                                                    SpeakerBadge {
                                                        label: seg.speaker;
                                                        accent: seg.is-mic;
                                                    }

                                                    Text {
                                                        text: seg.time;
                                                        font-size: Style.caption-size;
                                                        vertical-alignment: center;
                                                        color: Palette.foreground.transparentize(Style.muted-alpha);
                                                    }
                                                }

                                                Text {
                                                    text: seg.text;
                                                    wrap: word-wrap;
                                                    font-size: Style.body-size;
                                                    color: Palette.foreground;
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.segments.length == 0: Text {
                                    // 縮退表示は実際の状態を語る（ラベルの対応は Rust 側の
                                    // transcript_placeholder_text 参照。JSON の欠落・破損は状態 Done の
                                    // ままセグメントが空になり、未実施と同じ表示に落ちる）。完了済みの
                                    // 再実行中は旧トランスクリプトが残るため上の一覧表示が維持される。
                                    text: root.detail-transcript-placeholder;
                                    font-size: Style.body-size;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground.transparentize(Style.muted-alpha);
                                }
                            }

                            if root.showing-summary: Rectangle {
                                // 議事録があれば行一覧、無ければ縮退表示。長い議事録でも可視範囲
                                // だけ生成する（Transcript 側と同じ理由で ListView）。
                                if root.summary-rows.length > 0: ListView {
                                    for row in root.summary-rows: Rectangle {
                                        // ListView の行は自身の高さを明示する（word-wrap する
                                        // 本文の実高さに追従させる）。
                                        height: summary-row-content.preferred-height;
                                        summary-row-content := VerticalLayout {
                                            padding-left: 2px;
                                            padding-right: 6px;
                                            // 見出しは上に余白を置いて段落の切れ目を作る
                                            // （記号を落としているぶん、間隔で構造を見せる）。
                                            padding-top: row.is-heading ? 8px : 2px;
                                            padding-bottom: 2px;
                                            Text {
                                                text: row.text;
                                                wrap: word-wrap;
                                                // 見出しはサイズを上げず太さだけで差を付ける
                                                // （`heading-size` は本文より小さいので、
                                                // 使うと見出しと本文のサイズが逆転する）。
                                                font-size: Style.body-size;
                                                font-weight: row.is-heading
                                                    ? Style.semibold
                                                    : Style.regular;
                                                color: Palette.foreground;
                                            }
                                        }
                                    }
                                }
                                if root.summary-rows.length == 0: Text {
                                    // ラベルの対応は Rust 側の summary_placeholder_text 参照
                                    // （`summary.md` の欠落・破損・空はいずれも未生成と同じ表示に
                                    // 落ちる）。再生成中は旧議事録が残るため一覧表示が維持される。
                                    text: root.detail-summary-placeholder;
                                    font-size: Style.body-size;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground.transparentize(Style.muted-alpha);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 削除の確認モーダル。ウィンドウ内オーバーレイでテーマに追従する（`docs/plans` #66 の
    // デザイン準拠）。スクリムがクリックを吸収し、背後の一覧・ボタンは操作できない。
    // 閉じる操作は Cancel（何もしない）か Delete（削除を依頼して閉じる）のみ。
    if root.show-delete-confirm: Rectangle {
        background: #000000.transparentize(0.65);

        TouchArea { }

        Rectangle {
            width: 320px;
            height: dialog-layout.preferred-height;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 12px;

            dialog-layout := VerticalLayout {
                padding: 22px;
                padding-bottom: 16px;
                spacing: 7px;

                Text {
                    text: "Delete This Recording?";
                    font-size: Style.detail-title-size;
                    font-weight: Style.semibold;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: "The recording will be moved to the Trash.";
                    font-size: Style.caption-size;
                    color: Palette.foreground.transparentize(Style.muted-alpha);
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 11px;
                    spacing: 10px;

                    Button {
                        text: "Cancel";
                        horizontal-stretch: 1;
                        clicked => {
                            root.show-delete-confirm = false;
                        }
                    }

                    DangerButton {
                        text: "Delete";
                        filled: true;
                        horizontal-stretch: 1;
                        clicked => {
                            root.show-delete-confirm = false;
                            root.delete-session(root.selected-index);
                        }
                    }
                }
            }
        }
    }
}
