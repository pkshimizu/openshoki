import { ListView, ScrollView } from "std-widgets.slint";
import { Style, StatusTone } from "style.slint";
import { DangerButton, FocusRing, ActionButton, ButtonRole, Toggle, SearchField } from "controls.slint";

// 文字起こしの表示状態。Rust 側（main.rs の transcript_display_status）がワーカーの
// 進行状況と JSON の有無から合成して詰める。
export enum TranscriptStatus {
    not-transcribed,
    transcribing,
    done,
    failed,
}

// 議事録要約の表示状態。Rust 側（main.rs の summary_display_status）がワーカーの進行状況と
// `summary.md` の有無から合成して詰める。TranscriptStatus と同じ流儀（先頭が未生成＝既定値）。
export enum SummaryStatus {
    not-summarized,
    // 投入済みで、ワーカーが取り出すのを待っている（まだ CPU を使っていない）。この間だけ
    // 取り消せる（取り消しは状態行の隣に出す。理由は状態行のコメント）。
    queued,
    summarizing,
    done,
    failed,
}

// 読む領域の空表示から起こせる操作（#154）。**enum で渡す**——ラベルの文字列で分岐すると、
// 文言を直した日に操作が静かに壊れる。どれを出すかは Rust の網羅 match が決める。
export enum PaneActionKind {
    // 文字起こしを始める / やり直す。
    transcribe,
    // 議事録を書く / やり直す。
    write-notes,
    // キュー待ちの議事録を取り消す。
    cancel-notes,
    // 文字起こしの設定ウィンドウを開く。
    open-transcription,
    // 議事録の設定ウィンドウを開く。
    open-notes,
}

// 空表示に並べるボタン 1 つ分。**ラベルも Rust が組む**（状態→文言の対応表は Rust の
// 網羅 match が正。`docs/rules/slint.md`）。
export struct PaneAction {
    label: string,
    kind: PaneActionKind,
    // 主操作か。並ぶのは最大 2 つで、主は 1 つだけ（Rust 側が保証する）。
    primary: bool,
}

// 一覧の 1 行分。Rust の recordings::RecordingSession から詰める。
export struct SessionRow {
    // 日付のまとまりの見出し（`Today` / `Yesterday` / `Aug 5, 2026`）。空なら見出しを出さない。
    // **行に持たせる**のは、一覧が可視範囲だけを描くため——別の配列に分けると、行の添字と
    // セッションの添字が合わなくなる（添字は操作対象の解決に使う。`docs/rules/slint.md`）。
    group-heading: string,
    // 時刻（`14:02`）。行の中でいちばん大きく出す——同じ日の中では時刻で見分けるため。
    time-text: string,
    // 日付と長さ（`Aug 10, 2026 · 1:12:40`）。日付は見出しと重なるが、スクロールで見出しが
    // 流れても分かるように残す。長さが分からない録音では**区切りごと出さない**（#162）ので、
    // ここでは分岐しない（組み立ては `main::session_date_text`）。
    date-text: string,
    // 音源と状態を 1 行にしたもの（`Mic + system · transcribing 48%`）。**Rust が組む**
    // （状態→文言の対応表は Rust の網羅 match が正。`docs/rules/slint.md`）。
    detail-text: string,
    transcript-status: TranscriptStatus,
}

// 議事録要約の表示 1 行分。行分けと見出し判定（`#` を落として `is-heading` を立てる）は Rust の
// `summary_rows` が行う（**その doc が正**。Markdown をどこまで解釈するかもそちら）。
export struct SummaryRow {
    text: string,
    is-heading: bool,
}

// トランスクリプトの表示 1 行分。Rust の transcript::TranscriptSegment から詰める
// （speaker は "Mic" / "System"、time は "mm:ss"、1 時間以上は "h:mm:ss"）。配色判定はラベル文字列の
// 比較でなく is-mic で行う（ラベルを変えても配色が壊れないように）。クリック時のシーク秒は
// Rust 側が index で解決する。
export struct TranscriptRow {
    speaker: string,
    is-mic: bool,
    time: string,
    text: string,
}


// トランスクリプトの話者バッジ。Mic はアクセント色背景＋白文字、System はニュートラル背景。
component SpeakerBadge inherits Rectangle {
    in property <string> label;
    in property <bool> accent;
    border-radius: 4px;
    background: root.accent ? Style.seal : Style.sheet-sunken;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.label;
            font-size: Style.badge-size;
            font-weight: Style.semibold;
            color: root.accent ? Style.on-accent-foreground : Style.ink;
        }
    }
}

// 右ペイン下段の表示切替タブ（Transcript / Notes）。選択中は前景色＋下線、非選択は muted。
// std-widgets の TabWidget は枠と余白の見た目がこの画面（角丸 1px 枠のセクション）と合わないため、
// 見出し行に並べられる軽いタブを自作する（`SpeakerBadge` / `DangerButton` と同じ流儀）。
component ViewTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked();

    background: transparent;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.text;
            font-size: Style.heading-size;
            font-weight: root.selected ? Style.semibold : Style.regular;
            color: root.selected
                ? Style.ink
                : Style.ink-muted;
            // ラベルを読み上げるのはタブ自身（`accessible-label`）。
            accessible-role: none;
        }

        // 選択中だけ下線を出す（高さは常に確保して、切替でタブの高さが動かないようにする）。
        Rectangle {
            height: 2px;
            background: root.selected ? Style.seal : transparent;
        }
    }

    FocusRing {
        shown: focus.has-focus;
        radius: 0px;
    }

    // キーボードでも切り替えられるようにする（#146。自作部品は標準が持っていたものを
    // 自分で用意する。`docs/rules/slint.md`）。
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    accessible-role: tab;
    accessible-label: root.text;
    // タブの選択は **`checked` ではなく `item-selected`** で伝わる（accesskit がタブの
    // 役割で見るのはこちら）。`checked` を載せても実 AT には届かない。
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }
}

// 再生位置のシークバー。トラック＋アクセント色の塗り（従来の進捗バーのデザイン据え置き）に
// 現在位置のつまみを重ね、当たり判定はバーの上下へ広げて細いバーでも掴みやすくする。
//
// ドラッグ中の分担（**この仕様の正はここ**。他の箇所はここを参照する）: 押下から離すまでを
// `scrubbing` とし、その間は塗り・つまみ（この部品内）と時刻表示（`scrub-preview` → Rust）だけが
// ポインタへ追従するプレビューにして、音は動かさない。離した時点で `seek-to-ratio` を呼び、
// Rust 側が比率を秒へ換算してシークする。MP3 のシークを連続発行して音を途切れさせないためで、
// Rust の再生 tick は `scrubbing` 中 `progress` / 時刻表示の上書きを止める（つまみが震える競合の
// 予防）。コールバック名は使う側・Rust 側（`on_scrub_preview` / `on_seek_to_ratio`）と揃えている。
component SeekBar inherits Rectangle {
    // 使う側から渡される再生位置の比率（0.0〜1.0）。`scrubbing` 中はプレビュー比率が優先される。
    in property <float> progress;
    // 操作できるか。false ならクリック・ドラッグを受けず、つまみも出さない（表示専用に縮退）。
    in property <bool> seekable;
    // ドラッグ中か（上記の分担参照）。使う側の `out property` と `<=>` で束ねるため `in-out` に
    // する（`out` は双方向束縛の対象にできない）。値の更新はこの部品内だけで行い、束ねた時点で
    // 使う側と 1 つのプロパティになるため、ここに初期値は置かない。
    in-out property <bool> scrubbing;
    // ドラッグ中のプレビュー比率（0.0〜1.0）。`scrubbing` の間だけ塗り・つまみの位置に使う。
    property <float> scrub-ratio;
    // 塗り・つまみの位置に使う比率。ドラッグ中はプレビュー、それ以外は再生位置
    // （使う側から来る値は範囲外に備えて丸める）。
    property <float> ratio: root.scrubbing
        ? root.scrub-ratio
        : min(max(root.progress, 0.0), 1.0);
    property <length> knob-size: 13px;

    // ドラッグ中の時刻表示の更新依頼（比率）。シークはしない。
    callback scrub-preview(float);
    // クリック確定・ドラッグ終了（比率）。ここでシークする。
    callback seek-to-ratio(float);

    // 当たり判定の高さ。トラック・つまみはこの中央に置く。
    height: 20px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 5px;
        border-radius: 3px;
        background: Style.hairline;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            height: parent.height;
            border-radius: 3px;
            background: Style.seal;
        }
    }

    // つまみは操作できるときだけ出す。中心を塗りの右端に合わせ、両端ではバー内へ収まるよう丸める。
    if root.seekable: Rectangle {
        width: root.knob-size;
        height: self.width;
        border-radius: self.width / 2;
        x: min(max(root.width * root.ratio - self.width / 2, 0px), root.width - self.width);
        y: (root.height - self.height) / 2;
        background: Style.seal;
    }

    // キーボードでもシークできるようにする（#146。左右キーで 5% ずつ、Home / End で端へ）。
    // 押した瞬間に確定する（ドラッグのようなプレビューは挟まない）。
    function seek-by(delta: float) {
        root.seek-to-ratio(min(max(root.ratio + delta, 0.0), 1.0));
    }

    focus := FocusScope {
        enabled: root.seekable;
        key-pressed(event) => {
            // **掴んでいる間はキーを受けない**。掴むとフォーカスもここへ来るのでキーは届くが、
            // 確定してしまうと「音だけ飛んで、表示は掴んだ位置のまま、離すと元へ戻る」という
            // 食い違いになる（確定はポインタを離したときの 1 回に集める）。
            if (!root.seekable || root.scrubbing) {
                return reject;
            }
            if (event.text == Key.RightArrow) {
                root.seek-by(0.05);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.seek-by(-0.05);
                return accept;
            }
            if (event.text == Key.Home) {
                root.seek-to-ratio(0.0);
                return accept;
            }
            if (event.text == Key.End) {
                root.seek-to-ratio(1.0);
                return accept;
            }
            return reject;
        }
    }

    TouchArea {
        enabled: root.seekable;
        // ポインタ位置をバー上の比率へ換算した値（バー外へドラッグしても 0.0〜1.0 に収める）。
        property <float> pointer-ratio: min(max(self.mouse-x / self.width, 0.0), 1.0);
        // 追従は scrubbing のときだけ（左ボタン以外のドラッグで表示だけがずれるのを防ぐ）。
        moved => {
            if (root.scrubbing) {
                root.scrub-ratio = self.pointer-ratio;
                root.scrub-preview(root.scrub-ratio);
            }
        }
        // pointer-event はどのボタンでも来るため、開始・確定は左ボタンに限る
        // （右クリックでシークさせない）。取り消しはボタンを問わない。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                // 掴んだらフォーカスも移す（そのまま左右キーで微調整できる）。
                focus.focus();
                root.scrub-ratio = self.pointer-ratio;
                root.scrubbing = true;
                root.scrub-preview(root.scrub-ratio);
            } else if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.left
                && root.scrubbing) {
                root.seek-to-ratio(root.scrub-ratio);
                root.scrubbing = false;
            } else if (event.kind == PointerEventKind.cancel) {
                // 取り消し（ウィンドウ外へドラッグ等）はシークせず、プレビューを畳んで
                // 再生位置の表示へ戻す。
                root.scrubbing = false;
            }
        }
    }
    // シークできるので **`progress-indicator` ではなく `slider`**（読み取り専用の進捗表示だと、
    // 支援技術からはフォーカスも操作もできない要素に見える）。値は数値で出す——`"42%"` の
    // ような文字列にすると、数値ではなく文字列として読まれる。
    accessible-role: slider;
    accessible-label: "Playback position";
    accessible-value: round(root.ratio * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-enabled: root.seekable;
    accessible-action-increment => {
        if (root.seekable && !root.scrubbing) {
            root.seek-by(0.05);
        }
    }
    accessible-action-decrement => {
        if (root.seekable && !root.scrubbing) {
            root.seek-by(-0.05);
        }
    }
}

// 読む領域の空表示（#154）。**見出し・理由・次の操作**の 3 段で出す。
//
// 短いラベル 1 行に縮退させると「なぜ無いのか・どうすれば出るのか」が画面から分からない。
// 文言も操作も Rust が状態から組み立てて渡す（ここは並べるだけ）。
component EmptyState inherits Rectangle {
    in property <string> heading;
    // 見出しの下の 1〜2 文。空なら段ごと出さない。
    in property <string> body;
    in property <[PaneAction]> actions;

    callback action(PaneActionKind);

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        // 読む列いっぱいに広げない（1 行が長くなりすぎると読みにくい）。
        padding-left: 40px;
        padding-right: 40px;

        Text {
            text: root.heading;
            font-size: Style.body-size;
            font-weight: Style.semibold;
            horizontal-alignment: center;
            wrap: word-wrap;
            color: Style.ink;
        }

        if root.body != "": Text {
            text: root.body;
            font-size: Style.caption-size;
            horizontal-alignment: center;
            wrap: word-wrap;
            color: Style.ink-muted;
        }

        if root.actions.length > 0: HorizontalLayout {
            alignment: center;
            spacing: 10px;
            for item in root.actions: ActionButton {
                text: item.label;
                // 主操作は枠つきの既定、補助は控えめ（役割の意味は `ui/controls.slint`）。
                role: item.primary ? ButtonRole.plain : ButtonRole.quiet;
                clicked => {
                    root.action(item.kind);
                }
            }
        }
    }
}

// 文字起こしのセグメント一覧と、再生位置への追従（#154）。
//
// **追従を部品に閉じる**のは、`if` の内側で宣言した id を外から参照できないため
// （`docs/rules/slint.md`）。ウィンドウ側に関数を置くと ListView を掴めない。
component TranscriptList inherits Rectangle {
    in property <[TranscriptRow]> segments;
    in property <int> current-segment;
    // 再生位置をスクロールで追うか。**印は追従と無関係に常に付く**（読み返している場所を
    // 見失わせないため、追うかどうかだけを切り替える）。
    in property <bool> follow;

    callback seek-to-segment(int);

    // 平均行高での見当。**行が生成されていないときの粗い送り**にだけ使う——ListView は
    // 可視範囲しか作らないので、遠くへ飛んだ直後は行そのものが無く、正確な位置を訊けない。
    // 行の高さはまちまちなので、これは「近くまで運ぶ」以上のことはしない。
    private property <length> row-guess: root.segments.length > 0
        ? list.viewport-height / root.segments.length
        : 0px;
    private property <length> guess-y: root.current-segment * root.row-guess;

    // 行が生成されているときの**正確な**寄せ。`row-y` は viewport 内の位置。
    function scroll-into-view(row-y: length, row-height: length) {
        if (!root.follow) {
            return;
        }
        if (row-y + list.viewport-y < 0px) {
            root.set-viewport-y(-row-y);
        } else if (row-y + row-height + list.viewport-y > list.visible-height) {
            root.set-viewport-y(list.visible-height - row-y - row-height);
        }
    }

    // 粗い送り。**見当で画面内に入っているなら何もしない**——動かすと、行が生成されている
    // 場合に正確な位置から見当の位置へずらしてしまう（そのあと戻す口が無い）。
    function follow-current() {
        if (!root.follow || root.current-segment < 0 || root.segments.length == 0) {
            return;
        }
        if (root.guess-y + list.viewport-y >= 0px
            && root.guess-y + root.row-guess + list.viewport-y <= list.visible-height) {
            return;
        }
        root.set-viewport-y(-root.guess-y);
    }

    // 端を超えて送らない（`viewport-y` は「上へ隠れた量の負値」で、下端は本文の余りぶん）。
    function set-viewport-y(target: length) {
        list.viewport-y = max(min(target, 0px), min(0px, list.visible-height - list.viewport-height));
    }

    // 生成された時点でも寄せる（選んだ録音の再生位置が最初から先にある場合。`changed` は
    // 生成時には走らない——初期値は「変化」ではない）。
    init => {
        root.follow-current();
    }
    changed current-segment => {
        root.follow-current();
    }
    changed follow => {
        root.follow-current();
    }

    list := ListView {
        for seg[i] in root.segments: Rectangle {
            // 現在再生位置のセグメントをハイライト（淡色背景＋左 3px 罫線）。
            property <bool> active: i == root.current-segment;
            background: active ? Style.segment-highlight : transparent;
            // ListView の行は自身の高さを明示する（word-wrap する本文の実高さに追従させる）。
            height: row-content.preferred-height;
            TouchArea {
                clicked => {
                    root.seek-to-segment(i);
                }
            }

            // 再生中の行が生成された時点で、正確な位置へ寄せる。`init` を使うのは、行が
            // 作られた直後は `changed` が走らないため（生成時の値は「変化」ではない）。
            if active && root.follow: Rectangle {
                width: 0px;
                height: 0px;
                init => {
                    root.scroll-into-view(parent.y, parent.height);
                }
            }

            row-content := HorizontalLayout {
                // 左端のアクセント罫線（active のときだけ幅を持つ）。
                Rectangle {
                    width: active ? 3px : 0px;
                    background: Style.seal;
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 7px;
                        SpeakerBadge {
                            label: seg.speaker;
                            accent: seg.is-mic;
                        }

                        Text {
                            text: seg.time;
                            font-size: Style.caption-size;
                            vertical-alignment: center;
                            color: Style.ink-muted;
                        }
                    }

                    Text {
                        text: seg.text;
                        wrap: word-wrap;
                        font-size: Style.body-size;
                        color: Style.ink;
                    }
                }
            }
        }
    }
}

// トレイの「Recordings…」から開く録音一覧ウィンドウ。**3 つの領域**に分かれる（#128）:
// 左＝探す（300px 固定）、右＝読む（measure 640px）、下辺＝聴く（72px の常設帯）。
// 配色・サイズ・淡色はすべて共有の Style トークンから引く（#128 で Palette 依存を外した）
// （選択行の白文字はアクセント固定背景のため Style.on-accent-foreground）。
export component RecordingsWindow inherits Window {
    title: "Recordings";
    // 幅・高さは src/main.rs の RECORDINGS_WIDTH/HEIGHT と一致させること（片方だけ変えない）。
    // **読むことが主な仕事**なので広くする（#128 のデザイン）。720 幅では文字起こしが 1 行
    // 40 字ほどにしかならず、長い会議を読み返すのがつらい。
    min-width: 840px;
    min-height: 520px;
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Style.paper;

    // セッション一覧（新しい順）。Rust 側が list_sessions の結果で更新する。
    in property <[SessionRow]> sessions;
    // 一覧の下端に出す合計（`148 recordings`）。Rust が組む。
    in property <string> library-summary;
    // 検索欄の中身（#161）。**Rust が絞り込みの正**を持つので、ここは入力の受け皿。
    in-out property <string> search-text;
    // 絞り込み中に一覧の下へ出す件数（`3 of 148 recordings mention it`）。空なら合計を出す。
    in property <string> search-summary;
    // 選択中セッションの一覧インデックス。未選択は -1。行クリックで更新し select-session を呼ぶ。
    in-out property <int> selected-index: -1;
    // 選択セッションの詳細（Rust 側が選択時に更新する）。
    // 選んだ録音の中身を読み込んでいる最中か（#152）。**重い読み込みは別スレッドで行う**ので、
    // その間も操作はできる。空白のまま待たせないために、読み込み中であることを出す。
    in property <bool> loading;
    in property <bool> has-selection;
    in property <string> detail-datetime;
    in property <string> detail-sources;
    // 選択中セッションの文字起こし状態テキスト（Rust 側が組み立てる。例: Transcribed /
    // Transcribing… / Transcription failed / Not transcribed）。
    in property <string> detail-transcript-text;
    // 選択中セッションの文字起こし状態。状態テキストの失敗色の分岐と、実行中判定の導出に
    // 使う（Rust 側が detail-transcript-text と同時に更新する）。
    in property <TranscriptStatus> detail-transcript-status;
    // 読む領域（Transcript タブ）の空表示（#154。セグメントが無いときに出す）。見出し・理由・
    // 次の操作を Rust が状態から組み立てて渡す（`main::transcript_pane`）。
    in property <string> detail-transcript-heading;
    in property <string> detail-transcript-body;
    in property <[PaneAction]> detail-transcript-actions;
    // 選択中セッションが文字起こし中か。状態 enum から導出し、Rust から個別に set しない
    // （bool と enum の食い違いを作らない）。
    property <bool> detail-transcribing: root.detail-transcript-status == TranscriptStatus.transcribing;
    // 選択中セッションの議事録要約の状態テキスト（文言の対応表は Rust 側の
    // `summary_status_text` が正）。
    in property <string> detail-summary-status-text;
    // 議事録要約の状態。状態テキストの失敗色の分岐と、生成中判定の導出に使う
    // （Rust 側が detail-summary-status-text と同時に更新する）。
    in property <SummaryStatus> detail-summary-status;
    // 読む領域（Notes タブ）の空表示（#154。行が無いときに出す。`main::summary_pane`）。
    in property <string> detail-summary-heading;
    in property <string> detail-summary-body;
    in property <[PaneAction]> detail-summary-actions;
    // 議事録が出来上がっているときに一覧の下へ出す出典。空なら出さない。
    in property <string> detail-summary-footer;
    // 選択中セッションの議事録要約（`summary.md` を行単位に分けたもの）。空なら状態依存の
    // ラベルに縮退表示する。
    in property <[SummaryRow]> summary-rows;
    // 選択中セッションが要約生成中か（上の enum から導出。Rust から個別に set しない）。
    property <bool> detail-summarizing: root.detail-summary-status == SummaryStatus.summarizing;
    // 要約がキュー待ちか（まだ走っていないので取り消せる）。
    property <bool> detail-summary-queued: root.detail-summary-status == SummaryStatus.queued;
    // **ワーカーがこのセッションのファイルを読み書きしているか**。Delete の可否はこれ 1 つで
    // 決める（条件を各所へ複写しない。`docs/rules/slint.md`）。キュー待ちはまだ触っていない
    // ので含めない（Rust 側が取り消してから消す）。
    property <bool> detail-files-in-use: root.detail-transcribing || root.detail-summarizing;
    // **このセッションに仕事が積まれているか**（走行中＋キュー待ち）。新しい仕事を積ませない
    // 判断に使う（Transcribe / Summarize）。キュー待ちの要約は、いま文字起こしをやり直すと
    // 書き換え途中の JSON を読みかねないので、走っていなくても積ませない。
    property <bool> detail-jobs-pending: root.detail-files-in-use || root.detail-summary-queued;
    // 選択中セッションに文字起こしがあるか（要約の入力になるので、無ければ Summarize は無効）。
    in property <bool> has-transcript;
    // 選択セッションのトランスクリプト（mic.json / system.json をマージしたもの。新→旧でなく時刻順）。
    // 空なら Transcript セクションは状態依存のラベルに縮退表示する。
    in property <[TranscriptRow]> segments;
    // 現在の再生位置に対応するセグメントの index（ハイライト対象。-1 は該当なし）。
    in property <int> current-segment: -1;
    // 再生位置をスクロールで追うか（#154）。**UI が持つ表示の好み**なので設定には保存しない。
    // 既定は ON。切り替えが何に効くかは `TranscriptList.follow` の doc が正。
    in-out property <bool> follow-transcript: true;
    // 選択セッションが再生可能か（両音源は mix.mp3 生成済み、単一音源は常に可）。false なら
    // 再生ボタンを無効化する。
    in property <bool> playable;
    // 再生状態。playing は Play/Pause ラベルの切替、time-text は "mm:ss / mm:ss"、
    // progress は 0.0〜1.0 の進捗（シークバーの塗り・つまみの位置）。
    in property <bool> playing;
    in property <string> time-text;
    in property <float> progress;
    // シークバーを操作できるか（再生可能かつ全体長が分かる）。Rust 側が選択時に計算して渡す
    // （Slint 側で複合条件を組まない）。false なら表示専用に縮退する。
    in property <bool> seekable;
    // シークバーをドラッグ中か（分担は `SeekBar` の doc コメント参照）。Rust の再生 tick が
    // 上書き抑止の判定に読む。UI が所有する状態なので out にして Rust から set させない
    // （値は SeekBar 側と双方向で束ねる）。
    out property <bool> scrubbing;
    // 削除の確認モーダルの表示状態。Delete 押下で開き、Cancel / 確定で閉じる（Slint 内で完結）。
    in-out property <bool> show-delete-confirm: false;
    // 右ペイン下段が Notes タブを表示しているか（内部名が `summary` なのは `summary.md` が正だから。`docs/CONTEXT.md`）。タブの選択は UI が所有し、セッションを
    // 選び直しても保つ（アプリ側の Rust は Transcript / Notes の中身を常に最新へ更新するので、
    // どちらを見せているかを知る必要が無い＝set しない）。`in-out` なのは、確認用バイナリ
    // （`examples/transcript_view.rs`）が Notes タブの見た目を出すために選ぶため。
    in-out property <bool> showing-summary: false;

    // 行クリックでの選択通知。Rust 側で詳細更新・再生対象のロードを行う。
    // 検索語が変わった。**絞り込みは Rust が行う**（本文を読むので UI スレッドでは決めない）。
    callback search(string);
    // 検索を解除する（`✕` と 0 件表示の導線から）。
    callback clear-search();
    callback select-session(int);
    // 再生/一時停止トグルと停止。
    callback play-pause();
    callback stop();
    // トランスクリプトのセグメントクリック。その開始秒へ再生位置をスキップする（index を渡す）。
    callback seek-to-segment(int);
    // シークバーのドラッグ中のプレビュー通知（比率 0.0〜1.0）。時刻表示だけを更新する。
    callback scrub-preview(float);
    // シークバーのクリック確定・ドラッグ終了（比率 0.0〜1.0）。秒へ換算してシークする。
    callback seek-to-ratio(float);
    // 「Transcribe」押下。選択中セッションの文字起こしを（再）実行する。インデックスを渡す。
    callback transcribe-session(int);
    // 「Summarize」押下。選択中セッションの議事録要約を（再）生成する。インデックスを渡す
    // （設定 `auto_summarize` とは独立に、押されたら生成する）。
    callback summarize-session(int);
    // 「Cancel」押下（キュー待ちの間だけ出る）。積んだ要約ジョブを取り消す。
    callback cancel-summary(int);
    // 確認モーダルの Delete 押下。選択中セッションをゴミ箱へ移動する（インデックスを渡す）。
    callback delete-session(int);
    // 読む領域の空表示から起こす操作（#154）。どれを出すかは Rust が状態から決めるので、
    // ここは押されたものを返すだけ。
    callback pane-action(PaneActionKind);

    VerticalLayout {
        // 「探す・読む」を上に、「聴く」を下の常設帯に置く（デザインの 3 領域）。
        HorizontalLayout {
            padding: 16px;
            spacing: 14px;
            vertical-stretch: 1;

            // --- 探す: 左の固定幅の列（デザインの「find」） ---
            // **幅を固定する**のは、読む領域を可変にするため（ウィンドウを広げたぶんは本文が受け取る）。
            VerticalLayout {
                width: 300px;
                spacing: 10px;

                // 検索欄。**一覧の外に置く**——絞り込んで 0 件になっても、消す手が残るように。
                SearchField {
                    vertical-stretch: 0;
                    label: "Search recordings";
                    placeholder: "Search transcripts and notes";
                    text <=> root.search-text;
                    edited(text) => {
                        root.search(text);
                    }
                    cleared => {
                        root.clear-search();
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Style.rule;
                    border-radius: 8px;
                    background: Style.sheet;
                    clip: true;

                    // 空表示は**録音が無いのか、絞り込んで消えたのか**で言い分ける。同じ文にすると、
                    // 検索語を消せば戻ることが分からない。
                    if root.sessions.length == 0: VerticalLayout {
                        alignment: center;
                        padding: 24px;
                        spacing: 8px;
                        Text {
                            text: root.search-text != "" ? "No matches" : "No recordings yet";
                            font-size: Style.body-size;
                            font-weight: Style.semibold;
                            horizontal-alignment: center;
                            color: Style.ink;
                        }

                        Text {
                            text: root.search-text != ""
                                ? "No transcript or notes mention it. Recordings that have not been transcribed are not searched."
                                : "Start one from the shoki icon in the menu bar, or turn on Record automatically in Settings so meetings are captured for you.";
                            font-size: Style.caption-size;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            color: Style.ink-muted;
                        }

                        if root.search-text != "": HorizontalLayout {
                            alignment: center;
                            ActionButton {
                                text: "Clear search";
                                clicked => {
                                    root.clear-search();
                                }
                            }
                        }
                    }

                    if root.sessions.length > 0: VerticalLayout {
                        // **一覧は仮想化する**（`ListView`。`docs/rules/slint.md`）。
                        //
                        // ただし行の高さは 2 種類ある（見出しを持つ行だけ 28px 高い）。`ListView` は
                        // **平均の行高から総スクロール量を推定する**ので、見出しが可視範囲を出入りすると
                        // スクロールバーのつまみがわずかに揺れる。表示そのものは崩れない（要素の生成・
                        // 破棄は正しく行われる）ので、日付のまとまりが見える利点を取ってこの形にした。
                        ListView {
                            vertical-stretch: 1;
                            for row[i] in root.sessions: VerticalLayout {
                                // 日付のまとまりの見出し（`Today` など）。**行に持たせてある**ので、
                                // 仮想化しても添字がずれない（`SessionRow` の doc）。
                                if row.group-heading != "": Rectangle {
                                    height: 28px;
                                    background: Style.sheet-sunken;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        Text {
                                            text: row.group-heading;
                                            font-size: Style.caption-size;
                                            font-weight: Style.semibold;
                                            letter-spacing: Style.badge-tracking;
                                            color: Style.ink-faint;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                rowbg := Rectangle {
                                    // **高さを固定する**（デザイン: 62px）。各項目は 1 行でクリップし、
                                    // 長い文言で行が伸びないようにする——行ごとに高さが変わると、上の
                                    // 平均高の推定がさらに荒くなる。
                                    height: 62px;
                                    // 選択状態は id で参照する（レイアウトを跨ぐ parent 参照は Slint で
                                    // 使えないため）。
                                    property <bool> selected: i == root.selected-index;
                                    background: rowbg.selected ? Style.seal.transparentize(0.9) : transparent;

                                    HorizontalLayout {
                                        // 選択中の行は左端に朱の縦罫（一覧を目で走ったときに行頭で分かる）。
                                        Rectangle {
                                            width: 3px;
                                            background: rowbg.selected ? Style.seal : transparent;
                                        }

                                        VerticalLayout {
                                            padding-left: 11px;
                                            padding-right: 11px;
                                            spacing: 2px;
                                            alignment: center;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: row.time-text;
                                                    font-size: Style.body-size;
                                                    font-weight: Style.semibold;
                                                    color: Style.ink;
                                                    overflow: clip;
                                                    horizontal-stretch: 1;
                                                }
                                                // 文字起こしの状態を表すドット（前=透明で場所だけ確保 /
                                                // 中=進行中 / 完了 / 失敗）。
                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    y: 6px;
                                                    border-radius: 3px;
                                                    background: row.transcript-status == TranscriptStatus.done
                                                        ? Style.done-mark
                                                        : row.transcript-status == TranscriptStatus.transcribing
                                                            ? Style.caution-mark
                                                            : row.transcript-status == TranscriptStatus.failed
                                                                ? Style.danger
                                                                : transparent;
                                                }
                                            }

                                            Text {
                                                text: row.date-text;
                                                font-size: Style.caption-size;
                                                color: Style.ink-muted;
                                                overflow: clip;
                                            }

                                            Text {
                                                text: row.detail-text;
                                                font-size: Style.caption-size;
                                                color: row.transcript-status == TranscriptStatus.failed
                                                    ? Style.danger
                                                    : Style.ink-faint;
                                                overflow: clip;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.selected-index = i;
                                            root.select-session(i);
                                        }
                                    }
                                }
                            }
                        }

                        // 一覧の合計（何件あるか）。**下端に固定**して、スクロールしても件数が分かるように。
                        Rectangle {
                            height: 1px;
                            background: Style.hairline;
                        }
                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: root.search-summary != ""
                                    ? root.search-summary
                                    : root.library-summary;
                                font-size: Style.caption-size;
                                color: Style.ink-faint;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // --- 読む: 残り全部を使い、本文だけ measure で止める（デザインの「read」） ---
            Rectangle {
                horizontal-stretch: 1;

                if !root.has-selection: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "Nothing selected";
                        font-size: Style.body-size;
                        font-weight: Style.semibold;
                        horizontal-alignment: center;
                        color: Style.ink;
                    }
                    Text {
                        text: "Pick a recording on the left to listen to it and read its transcript.";
                        font-size: Style.caption-size;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        color: Style.ink-muted;
                    }
                }

                // alignment は既定（stretch）にし、余った高さを Transcript セクション
                // （vertical-stretch: 1）へ与える。alignment: start だと全子要素が推奨サイズに
                // 縮み、中身が可変の Transcript の箱が見出しだけに潰れる。
                // **本文は 640px で止める**（デザインの measure）。ウィンドウを広げたぶんは余白になる
                // ——1 行が長くなるほど、次の行の頭を探すのが難しくなる。
                if root.has-selection: HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 640px;
                        spacing: 12px;

                        // ヘッダ: 日時・音源の内訳と、文字起こし／議事録要約の状態＋
                        // Transcribe / Summarize / Delete。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.detail-datetime;
                                    font-size: Style.detail-title-size;
                                    font-weight: Style.semibold;
                                    color: Style.ink;
                                }

                                Text {
                                    text: root.detail-sources;
                                    font-size: Style.caption-size;
                                    color: Style.ink-muted;
                                }

                                // 文字起こしと議事録の状態を**同じ行に並べる**。2 行に分けると、どちらの
                                // 話をしているのかを目で追い直すことになる。キュー待ちの間だけ、その場に
                                // 取り消しを出す——**ボタン列と差し替えない**（同じ位置で「積む」と
                                // 「やめる」が入れ替わると、投入直後の 2 度押しが取り消しになる）。
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    Text {
                                        text: root.detail-transcript-text;
                                        font-size: Style.caption-size;
                                        vertical-alignment: center;
                                        // 失敗だけ警告色にして muted に埋もれさせず一目で分かるようにする。
                                        color: root.detail-transcript-status == TranscriptStatus.failed
                                            ? Style.danger
                                            : Style.ink-muted;
                                    }

                                    Text {
                                        text: "·";
                                        font-size: Style.caption-size;
                                        vertical-alignment: center;
                                        color: Style.ink-faint;
                                        accessible-role: none;
                                    }

                                    Text {
                                        text: root.detail-summary-status-text;
                                        font-size: Style.caption-size;
                                        vertical-alignment: center;
                                        // 失敗の扱いは文字起こしの状態行と揃える。
                                        color: root.detail-summary-status == SummaryStatus.failed
                                            ? Style.danger
                                            : Style.ink-muted;
                                    }

                                    if root.detail-summary-queued: ActionButton {
                                        text: "Cancel";
                                        compact: true;
                                        // 削除確認モーダルの「Cancel」と読み上げが衝突するので、
                                        // 支援技術向けには何を取り消すのかを明示する。
                                        accessible-label: "Cancel notes";
                                        clicked => {
                                            root.cancel-summary(root.selected-index);
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                HorizontalLayout {
                                spacing: 8px;
                                ActionButton {
                                    // 「やり直す」ことが分かる語にする——1 回目も再実行も同じボタンだが、
                                    // 押す動機は「言語やモデルを変えたのでもう一度」が主。
                                    text: root.has-transcript ? "Re-transcribe" : "Transcribe";
                                    // 完了済み・失敗・未実施のいずれからも（再）実行できる
                                    // （言語・モデル変更後のやり直し用途）。無効化の理由は
                                    // detail-jobs-pending。
                                    enabled: !root.detail-jobs-pending;
                                    clicked => {
                                        root.transcribe-session(root.selected-index);
                                    }
                                }

                                ActionButton {
                                    text: root.detail-summary-status == SummaryStatus.done
                                        ? "Regenerate notes"
                                        : "Write notes";
                                    // 要約は文字起こしを入力にするので、無いセッションでは押させない
                                    // （生成済み・失敗からは押し直せる。モデル変更後のやり直し用途）。
                                    // 取り消しはこのボタンを差し替えず、状態行の隣に出す（理由は
                                    // 状態行のコメント）。
                                    enabled: root.has-transcript && !root.detail-jobs-pending;
                                    clicked => {
                                        root.summarize-session(root.selected-index);
                                    }
                                }

                                DangerButton {
                                    // 押すと確認が出ることを「…」で示す（押した瞬間に消えない）。
                                    text: "Delete…";
                                    // キュー待ちなら消せる（Rust 側が取り消してから削除する）。
                                    enabled: !root.detail-files-in-use;
                                    clicked => {
                                        root.show-delete-confirm = true;
                                    }
                                }
                                }
                            }
                        }

                        // Transcript / Notes セクション。タブで表示を切り替える。Transcript は
                        // セグメントを時刻順に表示し、現在再生位置をハイライト、クリックでその開始秒へ
                        // シークする。Summary は `summary.md` を行単位に表示する（クリック連動は無い。
                        // #81 のスコープ外）。どちらも中身が無いときは状態依存のラベルに縮退。
                        Rectangle {
                            vertical-stretch: 1;
                            border-width: 1px;
                            border-color: Style.rule;
                            border-radius: 8px;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 10px;
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    alignment: start;
                                    spacing: 18px;
                                    ViewTab {
                                        text: "Transcript";
                                        selected: !root.showing-summary;
                                        clicked => {
                                            root.showing-summary = false;
                                        }
                                    }

                                    ViewTab {
                                        text: "Notes";
                                        selected: root.showing-summary;
                                        clicked => {
                                            root.showing-summary = true;
                                        }
                                    }
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    clip: true;

                                    if !root.showing-summary: Rectangle {
                                        // 文字起こしがあればセグメント一覧、無ければ状態ごとの
                                        // 空表示（#154）。JSON の欠落・破損は状態 `Done` のまま
                                        // セグメントが空になり、未実施と同じ空表示に落ちる。
                                        // 完了済みの再実行中は旧トランスクリプトが残るため、
                                        // 一覧表示が維持される。
                                        if root.segments.length > 0: TranscriptList {
                                            segments: root.segments;
                                            current-segment: root.current-segment;
                                            follow: root.follow-transcript;
                                            seek-to-segment(index) => {
                                                root.seek-to-segment(index);
                                            }
                                        }
                                        // **読み込み中はそう言う**（#152）。空白のまま待たせると、
                                        // 「文字起こしが無い」のか「まだ読んでいる」のか分からない。
                                        if root.segments.length == 0: EmptyState {
                                            heading: root.loading
                                                ? "Loading…"
                                                : root.detail-transcript-heading;
                                            body: root.loading ? "" : root.detail-transcript-body;
                                            actions: root.loading ? [] : root.detail-transcript-actions;
                                            action(kind) => {
                                                root.pane-action(kind);
                                            }
                                        }
                                    }

                                    if root.showing-summary: Rectangle {
                                        // 議事録があれば行一覧、無ければ空表示。長い議事録でも可視範囲
                                        // だけ生成する（Transcript 側と同じ理由で ListView）。
                                        // 出典（誰がいつ書いたか）は**一覧の下**に置く——上に置くと
                                        // 本文より先に読ませることになる。空なら段ごと出さない。
                                        if root.summary-rows.length > 0: VerticalLayout {
                                            spacing: 8px;
                                            ListView {
                                                vertical-stretch: 1;
                                                for row in root.summary-rows: Rectangle {
                                                    // ListView の行は自身の高さを明示する（word-wrap する
                                                    // 本文の実高さに追従させる）。
                                                    height: summary-row-content.preferred-height;
                                                    summary-row-content := VerticalLayout {
                                                        padding-left: 2px;
                                                        padding-right: 6px;
                                                        // 見出しは上に余白を置いて段落の切れ目を作る
                                                        // （記号を落としているぶん、間隔で構造を見せる）。
                                                        padding-top: row.is-heading ? 8px : 2px;
                                                        padding-bottom: 2px;
                                                        Text {
                                                            text: row.text;
                                                            wrap: word-wrap;
                                                            // 見出しはサイズを上げず太さだけで差を付ける
                                                            // （`heading-size` は本文より小さいので、
                                                            // 使うと見出しと本文のサイズが逆転する）。
                                                            font-size: Style.body-size;
                                                            font-weight: row.is-heading
                                                                ? Style.semibold
                                                                : Style.regular;
                                                            color: Style.ink;
                                                        }
                                                    }
                                                }
                                            }

                                            if root.detail-summary-footer != "": Text {
                                                text: root.detail-summary-footer;
                                                font-size: Style.caption-size;
                                                color: Style.ink-muted;
                                                wrap: word-wrap;
                                                vertical-stretch: 0;
                                            }
                                        }
                                        if root.summary-rows.length == 0: EmptyState {
                                            // 文言の対応は Rust 側の `summary_pane` 参照
                                            // （`summary.md` の欠落・破損・空はいずれも未生成と
                                            // 同じ空表示に落ちる）。再生成中は旧議事録が残るため
                                            // 一覧表示が維持される。
                                            heading: root.loading
                                                ? "Loading…"
                                                : root.detail-summary-heading;
                                            body: root.loading ? "" : root.detail-summary-body;
                                            actions: root.loading ? [] : root.detail-summary-actions;
                                            action(kind) => {
                                                root.pane-action(kind);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                }
            }
        }

        // --- 聴く: 下辺の常設プレイヤー帯（デザインの「listen」） ---
        // **高さを固定して常に置く**。100ms の時計で高さが変わると、そのたびに上の本文が
        // 流れ直す。選択が無いときも帯は残し、ウィンドウの形を変えない。
        Rectangle {
            height: 72px;
            background: Style.sheet;
            VerticalLayout {
                Rectangle {
                    height: 1px;
                    background: Style.rule;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                text: root.playing ? "Pause" : "Play";
                                enabled: root.playable;
                                clicked => {
                                    root.play-pause();
                                }
                            }

                            ActionButton {
                                text: "Stop";
                                role: ButtonRole.quiet;
                                enabled: root.playable;
                                clicked => {
                                    root.stop();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        horizontal-stretch: 1;

                        // 再生位置のシークバー（分担・仕様は SeekBar の doc コメント参照）。
                        SeekBar {
                            progress: root.progress;
                            seekable: root.seekable;
                            scrubbing <=> root.scrubbing;
                            scrub-preview(ratio) => {
                                root.scrub-preview(ratio);
                            }
                            seek-to-ratio(ratio) => {
                                root.seek-to-ratio(ratio);
                            }
                        }
                    }

                    // 再生位置の追従スイッチ。**プレイヤー帯に置く**のは、追うかどうかが
                    // 再生の話だから（読む領域のタブを跨いでも同じ設定が効く）。
                    VerticalLayout {
                        alignment: center;
                        // 余りはシークバーへ渡す（ここが伸びると、ラベルとスイッチの間が開く）。
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Text {
                                text: "Follow transcript";
                                font-size: Style.caption-size;
                                color: Style.ink-muted;
                                vertical-alignment: center;
                                // スイッチが同じ文字列を `accessible-label` に持つので、
                                // ここは読み上げ対象から外す（付けないと 2 回読まれる。
                                // `docs/rules/slint.md`）。
                                accessible-role: none;
                            }

                            Toggle {
                                label: "Follow transcript";
                                checked <=> root.follow-transcript;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            // 時刻は**等幅**で出す（桁が変わるたびに左右が動かないように）。
                            text: root.time-text;
                            font-family: "Menlo";
                            font-size: Style.caption-size;
                            color: Style.ink-muted;
                            vertical-alignment: center;
                        }
                    }

                }
            }
        }
    }

    // 削除の確認モーダル。ウィンドウ内オーバーレイでテーマに追従する（`docs/plans` #66 の
    // デザイン準拠）。スクリムがクリックを吸収し、背後の一覧・ボタンは操作できない。
    // 閉じる操作は Cancel（何もしない）か Delete（削除を依頼して閉じる）のみ。
    if root.show-delete-confirm: Rectangle {
        background: #000000.transparentize(0.65);

        TouchArea { }

        Rectangle {
            width: 320px;
            height: dialog-layout.preferred-height;
            background: Style.sheet;
            border-width: 1px;
            border-color: Style.rule;
            border-radius: 12px;

            dialog-layout := VerticalLayout {
                padding: 22px;
                padding-bottom: 16px;
                spacing: 7px;

                Text {
                    text: "Move this recording to the Trash?";
                    font-size: Style.detail-title-size;
                    font-weight: Style.semibold;
                    color: Style.ink;
                    horizontal-alignment: center;
                }

                Text {
                    // **何が一緒に消えるか**を言う（音声だけだと思って押させない）。
                    text: root.detail-datetime + " · " + root.detail-sources;
                    font-size: Style.caption-size;
                    color: Style.ink-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    // 戻せることも言う（ゴミ箱を空にするまでは元に戻せる）。
                    text: "The audio, its transcript and its notes go to the Trash together. You can put them back from the Trash until you empty it.";
                    font-size: Style.caption-size;
                    color: Style.ink-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 11px;
                    spacing: 10px;

                    ActionButton {
                        // 「消さずに戻る」ことが分かる語にする（デザインの `Keep`）。
                        text: "Keep";
                        horizontal-stretch: 1;
                        clicked => {
                            root.show-delete-confirm = false;
                        }
                    }

                    DangerButton {
                        // ゴミ箱へ入るだけで消えないことを語で示す（戻せる操作だと分かる）。
                        text: "Move to Trash";
                        filled: true;
                        horizontal-stretch: 1;
                        clicked => {
                            root.show-delete-confirm = false;
                            root.delete-session(root.selected-index);
                        }
                    }
                }
            }
        }
    }
}
